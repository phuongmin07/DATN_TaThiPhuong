import cv2
from ultralytics import YOLO

# Load model
model = YOLO("best.pt")

def resize_keep_ratio(img, max_width=800):
    h, w = img.shape[:2]
    if w > max_width:
        scale = max_width / w
        return cv2.resize(img, (int(w * scale), int(h * scale)))
    return img

def detect_yolo(image_path):
    img = cv2.imread(image_path)

    results = model(img, imgsz=640, conf=0.4)

    class_info = {
        0: {"name": "Person", "color": (255, 0, 0)},
        1: {"name": "Motorbike", "color": (0, 0, 255)},
        2: {"name": "Helmet", "color": (0, 255, 0)}
    }

    for result in results:
        for box in result.boxes:
            cls_id = int(box.cls[0])
            conf = float(box.conf[0])

            if cls_id not in class_info:
                continue

            x1, y1, x2, y2 = map(int, box.xyxy[0])

            label = f"{class_info[cls_id]['name']} {conf:.2f}"
            color = class_info[cls_id]['color']

            cv2.rectangle(img, (x1, y1), (x2, y2), color, 2)
            cv2.putText(img, label, (x1, y1 - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, color, 2)

    img_show = resize_keep_ratio(img)

    cv2.imshow("Result", img_show)
    cv2.waitKey(0)
    cv2.destroyAllWindows()

# Chạy thử
detect_yolo("test.jpg")
